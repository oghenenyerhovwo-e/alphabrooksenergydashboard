generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryProduct {
  CNG
  AGO
  PMS
  LPG_BULK
  LPG_CYLINDERS
  OTHER
}

enum DeliveryUnit {
  SCM
  KG
  MT
  LITRES
  OTHER
}

enum DeliveryStatus {
  DRAFT
  ASSIGNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  REJECTED
  FAILED
  RETURNED
  CANCELLED
}

enum VehicleInspectionStatus {
  READY_TO_DEPART
  NOT_READY_TO_DEPART
}

enum UserRole {
  ADMIN
  BUSINESS_DEVELOPMENT
  SALES
  OPERATIONS
  FINANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model DeliveryNoteCounter {
  year         Int @id
  lastSequence Int @default(0)
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries                Delivery[]
  vehiclePreTripInspections VehiclePreTripInspection[]

  @@index([name])
  @@index([active])
}

model Vehicle {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries                Delivery[]
  vehiclePreTripInspections VehiclePreTripInspection[]

  @@index([plateNumber])
  @@index([active])
}

model Delivery {
  id                 String @id @default(cuid())
  deliveryNoteNumber String @unique

  // Customer
  customer         String
  customerLocation String?
  deliveryAddress  String
  contactEmail     String

  // Product / quantity
  product           DeliveryProduct
  unit              DeliveryUnit
  quantityLoaded    Float?
  quantityDelivered Float?
  quantityReturned  Float?
  loadingPoint      String?
  deliveryPoint     String?

  // Driver & vehicle
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  trailerNumber  String?
  odometerBefore Float?
  odometerAfter  Float?

  // Journey
  departureLocation  String?
  destination        String
  departureAt        DateTime?
  arrivalAt          DateTime?
  routeTaken         String?
  distanceTravelled  Float?
  routeDeviation     Boolean   @default(false)
  routeDeviationNote String?

  // Delivery confirmation
  status          DeliveryStatus @default(DRAFT)
  receiverName    String?
  receiverPhone   String?
  deliveryRemarks String?

  // Issue reporting
  hasIssue         Boolean @default(false)
  issueType        String?
  issueDescription String?
  needsAttention   Boolean @default(false)

  // Signatures (captured at delivery completion)
  driverSignatureUrl   String?
  receiverSignatureUrl String?

  // Related records
  auditLogs         DeliveryAuditLog[]
  preTripInspection VehiclePreTripInspection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

model DeliveryAuditLog {
  id String @id @default(cuid())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  actorName String
  actorRole String
  action    String
  details   String?

  createdAt DateTime @default(now())

  @@index([deliveryId])
  @@index([createdAt])
}

model VehiclePreTripInspection {
  id String @id @default(cuid())

  deliveryId String   @unique
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  driverName    String
  vehicleNumber String

  inspectionDate  DateTime
  odometerReading Float

  tyresSatisfactory              Boolean
  brakesSatisfactory             Boolean
  lightsSatisfactory             Boolean
  hornSatisfactory               Boolean
  mirrorsSatisfactory            Boolean
  vehicleBodySatisfactory        Boolean
  fireExtinguisherSatisfactory   Boolean
  firstAidKitSatisfactory        Boolean
  emergencyEquipmentSatisfactory Boolean
  vehicleDocumentsSatisfactory   Boolean

  hasDefect         Boolean
  defectDescription String?
  defectPhotoUrl    String?

  inspectionStatus VehicleInspectionStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([vehicleId])
  @@index([vehicleNumber])
  @@index([driverName])
  @@index([inspectionDate])
  @@index([inspectionStatus])
}

/// A staff member who can sign in. `entraId` is their Microsoft Entra ID
/// (Azure AD) object ID — the same identifier already used informally in
/// src/config/users.ts to label Planner task assignees.
model User {
  id      String @id @default(cuid())
  entraId String @unique

  email  String? @unique
  name   String
  role   UserRole
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  // --- Outcomes (added Phase 1) ---
  outcomeTargetsAsStaff      OutcomeTarget[]      @relation("OutcomeTargetStaff")
  outcomeTargetsCreated      OutcomeTarget[]      @relation("OutcomeTargetCreatedBy")
  outcomeTargetsUpdated      OutcomeTarget[]      @relation("OutcomeTargetUpdatedBy")
  outcomeAchievementsAsStaff OutcomeAchievement[] @relation("OutcomeAchievementStaff")
  outcomeAchievementsCreated OutcomeAchievement[] @relation("OutcomeAchievementCreatedBy")
  outcomeAchievementsUpdated OutcomeAchievement[] @relation("OutcomeAchievementUpdatedBy")

  createdLeads           Lead[]         @relation("LeadCreatedBy")
  qualifiedLeads         Lead[]         @relation("LeadQualifiedBy")
  createdQuoteRequests   QuoteRequest[] @relation("QuoteRequestCreatedBy")
  qualifiedQuoteRequests QuoteRequest[] @relation("QuoteRequestQualifiedBy")

  @@index([role])
  @@index([status])
}

/// Server-side session record. The cookie holds only a random opaque
/// token; `tokenHash` is a SHA-256 hash of that token, so a leaked
/// database row alone cannot be replayed as a valid session.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SALES
  BUSINESS_DEVELOPMENT
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum LeadStatus {
  ACTIVE
  CLOSED
}

enum QualificationState {
  PENDING
  QUALIFIED
  DISQUALIFIED
}

enum QuoteRequestStatus {
  OPEN
  CLOSED
}

model LeadReferenceCounter {
  year         Int @id
  lastSequence Int @default(0)
}

model QuoteRequestReferenceCounter {
  year         Int @id
  lastSequence Int @default(0)
}

model Lead {
  id              String @id @default(cuid())
  referenceNumber String @unique

  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  location      String?

  source          LeadSource
  productInterest DeliveryProduct?
  notes           String?

  status              LeadStatus         @default(ACTIVE)
  qualificationState  QualificationState @default(PENDING)
  qualificationReason String?
  qualifiedAt         DateTime?

  qualifiedById String?
  qualifiedBy   User?   @relation("LeadQualifiedBy", fields: [qualifiedById], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteRequests QuoteRequest[]
  auditLogs     CommercialAuditLog[]

  @@index([status])
  @@index([qualificationState])
  @@index([source])
  @@index([createdAt])
  @@index([createdById])
  @@index([qualifiedById])
}

model QuoteRequest {
  id              String @id @default(cuid())
  referenceNumber String @unique

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  requestedProduct  DeliveryProduct
  requestedQuantity Float?
  unit              DeliveryUnit?

  deliveryLocation      String?
  requestedDeliveryDate DateTime?
  description           String?
  notes                 String?

  status              QuoteRequestStatus @default(OPEN)
  qualificationState  QualificationState @default(PENDING)
  qualificationReason String?
  qualifiedAt         DateTime?

  qualifiedById String?
  qualifiedBy   User?   @relation("QuoteRequestQualifiedBy", fields: [qualifiedById], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("QuoteRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs CommercialAuditLog[]

  @@index([leadId])
  @@index([status])
  @@index([qualificationState])
  @@index([createdAt])
  @@index([createdById])
  @@index([qualifiedById])
}

model CommercialAuditLog {
  id String @id @default(cuid())

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  quoteRequestId String?
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  actorName String
  actorRole String
  action    String
  details   String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([quoteRequestId])
  @@index([createdAt])
}

/// MAIN OPERATIONS — HISTORICAL DAILY REPORT SNAPSHOT (Phase 6).
///
/// One row per Africa/Lagos reporting date. This is a REPORTING ARCHIVE,
/// not a task store: the whole report tree lives in a single immutable
/// JSON document, there are no per-task rows to update, and nothing here
/// is ever written back to Planner. Microsoft Planner remains the source
/// of truth for all task state.
///
/// `reportDate` is a plain "YYYY-MM-DD" string rather than a DateTime on
/// purpose — a DateTime column round-trips through UTC and would let a
/// Lagos reporting date silently shift to the previous day on a UTC
/// server. A string cannot drift.
model OperationsDailyReport {
  id String @id @default(cuid())

  /// Africa/Lagos calendar date, "YYYY-MM-DD". Unique — this is what
  /// makes snapshot capture idempotent and historical reports immutable.
  reportDate String @unique
  timezone   String @default("Africa/Lagos")

  /// The instant the snapshot was taken (UTC).
  capturedAt DateTime @default(now())

  /// Planner connection status at capture time. Only "connected"
  /// snapshots are ever written.
  connectionStatus String

  // Deterministic headline figures, denormalized so a calendar month can
  // be indexed without deserializing every JSON document. All computed by
  // application code over UNIQUE Planner tasks — never by AI.
  totalUniqueTasks     Int
  completedUniqueTasks Int
  /// null (never 0) when there were no tasks at all on that date.
  completionPercentage Int?
  completedCount       Int
  inProgressCount      Int
  pendingCount         Int
  overdueCount         Int
  blockerCount         Int

  /// The full report tree: employees, departments, tasks, Planner Notes,
  /// parsed UPDATE/BLOCKER/NEXT sections, overall statistics.
  snapshot Json

  @@index([capturedAt])
}

enum OutcomeProduct {
  AGO
  CNG
  LPG
}

enum OutcomeUnit {
  LITRES
  SCM
  KG
  TONNES
  UNITS
}

/// OUTCOMES — MONTHLY STAFF TARGET (Phase 1).
///
/// "What was expected?" for one staff member, one product, one
/// calendar month. Independent of OutcomeAchievement — creating a
/// target never creates or implies an achievement, and vice versa.
/// Period identity is the normalized (year, month) pair, never a
/// display string like "January 2026" — see src/lib/outcomes/period.ts.


/// OUTCOMES — MONTHLY STAFF ACHIEVEMENT (Phase 1).
///
/// "What was actually produced?" for one staff member, one product,
/// one calendar month. Independent of OutcomeTarget — a target need
/// not exist first, and achievement is never derived from or capped
/// by target. The ABSENCE of a row for a given staff/product/month is
/// the "no achievement entered yet" state; it is never represented as
/// a row with achievedValue = 0. Application code (see
/// src/lib/outcomes/calculations.ts) must preserve that distinction.


/// OUTCOMES — MONTHLY STAFF TARGET.
///
/// "What was expected?" for one staff member, one product, one
/// calendar month. Independent of OutcomeAchievement.
///
/// The business model is:
///
/// targetQuantity × targetMarginPerUnit = targetGeneratedValue
///
/// `targetQuantity` is mapped to the existing `targetValue` database
/// column so existing quantity data is preserved during the transition.
///
/// The financial fields are nullable for historical compatibility.
/// New target records will receive their authoritative values through
/// the server-side application flow in later implementation phases.
model OutcomeTarget {
  id String @id @default(cuid())

  userId String
  user   User   @relation("OutcomeTargetStaff", fields: [userId], references: [id], onDelete: Restrict)

  product OutcomeProduct
  year    Int
  month   Int

  /// Physical target quantity.
  ///
  /// This is intentionally mapped to the existing database column
  /// `targetValue` because that column currently stores quantity.
  ///
  /// The database column precision is increased from DECIMAL(14,2)
  /// to DECIMAL(20,3) by the Phase 1 migration.
  targetQuantity Decimal @map("targetValue") @db.Decimal(20, 3)

  /// Unit associated with the target quantity.
  unit OutcomeUnit

  /// Margin generated per unit of the configured quantity.
  ///
  /// Nullable temporarily so historical quantity-only records remain
  /// valid. New records will be required to provide this through the
  /// server-authoritative submission flow.
  targetMarginPerUnit Decimal? @db.Decimal(18, 4)

  /// Server-derived monetary target value.
  ///
  /// Authoritative relationship:
  ///
  /// targetQuantity × targetMarginPerUnit = targetGeneratedValue
  ///
  /// This is not an independently editable business input.
  ///
  /// Nullable temporarily for historical quantity-only records.
  targetGeneratedValue Decimal? @db.Decimal(30, 2)

  createdById String
  createdBy   User   @relation("OutcomeTargetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("OutcomeTargetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// At most one target per staff/product/month.
  @@unique([userId, product, year, month])
  @@index([product, year, month])
  @@index([userId])
  @@index([createdById])
}

/// OUTCOMES — MONTHLY STAFF ACHIEVEMENT.
///
/// "What was actually produced?" for one staff member, one product,
/// one calendar month. Independent of OutcomeTarget.
///
/// The business model is:
///
/// achievedQuantity × achievedMarginPerUnit = achievedGeneratedValue
///
/// `achievedQuantity` is mapped to the existing `achievedValue`
/// database column so existing quantity data is preserved during
/// the transition.
///
/// The absence of an achievement row continues to mean that no
/// achievement has been entered yet.
model OutcomeAchievement {
  id String @id @default(cuid())

  userId String
  user   User   @relation("OutcomeAchievementStaff", fields: [userId], references: [id], onDelete: Restrict)

  product OutcomeProduct
  year    Int
  month   Int

  /// Physical achieved quantity.
  ///
  /// This is intentionally mapped to the existing database column
  /// `achievedValue` because that column currently stores quantity.
  ///
  /// The database column precision is increased from DECIMAL(14,2)
  /// to DECIMAL(20,3) by the Phase 1 migration.
  achievedQuantity Decimal @map("achievedValue") @db.Decimal(20, 3)

  /// Unit associated with the achieved quantity.
  unit OutcomeUnit

  /// Margin generated per unit of the achieved quantity.
  ///
  /// Nullable temporarily so historical quantity-only records remain
  /// valid. New records will be required to provide this through the
  /// server-authoritative submission flow.
  achievedMarginPerUnit Decimal? @db.Decimal(18, 4)

  /// Server-derived monetary achievement value.
  ///
  /// Authoritative relationship:
  ///
  /// achievedQuantity × achievedMarginPerUnit = achievedGeneratedValue
  ///
  /// This is not an independently editable business input.
  ///
  /// Nullable temporarily for historical quantity-only records.
  achievedGeneratedValue Decimal? @db.Decimal(30, 2)

  createdById String
  createdBy   User   @relation("OutcomeAchievementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("OutcomeAchievementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// At most one achievement per staff/product/month.
  @@unique([userId, product, year, month])
  @@index([product, year, month])
  @@index([userId])
  @@index([createdById])
}